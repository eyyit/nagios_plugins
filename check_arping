#!/bin/bash
# Usage: ./check_arping.sh [IP|hostname] [Interface]

HOST="${1:-}"
INTERFACE="${2:-eth0}"
MAX_ATTEMPTS=5

if [[ -z "$HOST" ]]; then
  echo "UNKNOWN - Usage: $0 [IP|hostname] [Interface]"
  exit 3
fi

for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
  reply=$(/usr/bin/sudo /usr/sbin/arping -c 1 -w 2 -I "$INTERFACE" "$HOST" 2>&1)
  exit_code=$?

  if [[ $exit_code -eq 0 ]]; then
    echo "OK - ARP Reply received from $HOST on attempt $attempt/$MAX_ATTEMPTS | $(echo "$reply" | tr '\n' ' ')"
    exit 0
  fi
done

echo "CRITICAL - No ARP Reply from $HOST after $MAX_ATTEMPTS attempts | $(echo "$reply" | tr '\n' ' ')"
exit 2
