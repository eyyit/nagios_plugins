#!/usr/bin/python3

import argparse
import math
import subprocess
import sys


class NagiosArgumentParser(argparse.ArgumentParser):

  def error(self, message):
    print(f'CERT CHAIN UNKNOWN: {message}')
    raise SystemExit(3)


def main():
  parser = NagiosArgumentParser()
  parser.add_argument('--host', required=True,
                      help='Hostname of the service to check.')
  parser.add_argument('--port', type=int, default=443,
                      help='Port number to check (default: 443).')
  parser.add_argument('--server',
                      help='TLS server name (defaults to --host).')
  parser.add_argument('--timeout', type=float, default=5,
                      help='Check timeout in seconds (default: 5).')
  args = parser.parse_args()

  if not 1 <= args.port <= 65535:
    parser.error('Port must be between 1 and 65535.')
  if not math.isfinite(args.timeout) or args.timeout <= 0:
    parser.error('Timeout must be a finite number greater than zero.')
  server = args.server or args.host
  command = [
      'openssl', 's_client', '-connect', f'{args.host}:{args.port}',
      '-servername', server,
  ]

  for attempt in range(1, 5):
    try:
      result = subprocess.run(
          command, input='', capture_output=True, text=True,
          timeout=args.timeout, check=False)
    except subprocess.TimeoutExpired:
      if attempt == 4:
        print(f'CERT CHAIN UNKNOWN: Check timed out after {attempt} attempts.')
        return 3
      continue
    except OSError as error:
      print(f'CERT CHAIN UNKNOWN: Unable to run openssl: {error}')
      return 3
    break

  if result.returncode:
    detail = result.stderr.strip().splitlines()
    message = detail[-1] if detail else f'openssl exited {result.returncode}'
    print(f'CERT CHAIN UNKNOWN: {message}')
    return 3

  output = '\n'.join((result.stdout, result.stderr))
  verification = ''
  for line in output.splitlines():
    if line.strip().startswith('Verify return code:'):
      verification = line.strip()

  if verification == 'Verify return code: 0 (ok)':
    print(f'CERT CHAIN OK: {verification}')
    return 0
  if verification:
    print(f'CERT CHAIN CRITICAL: {verification}')
    return 2

  print('CERT CHAIN UNKNOWN: openssl output did not contain verification status.')
  return 3


if __name__ == '__main__':
  sys.exit(main())
