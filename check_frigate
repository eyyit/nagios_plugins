def finite(value: Any) -> float:
    """Reject non-numeric or non-finite diagnostics."""
    number = float(value)
    if not math.isfinite(number):
        raise ValueError('Non-finite diagnostic')
    return number


def recording_gaps(intervals: list[list[float]], now: float,
                   lookback: float = 900, minimum_gap: float = 30) -> list[tuple[float, float]]:
    """Find recovered coverage holes >=30s intersecting the last 15 minutes.

    Merge overlapping segments, clip holes to the lookback, and leave the
    unfinished tail to the separate recording-age thresholds. No prior segment
    means unknown earlier coverage, not proof of an earlier recording gap.
    """
    cutoff = now - lookback
    previous_end: float | None = None
    gaps: list[tuple[float, float]] = []
    normalized = sorted((finite(start), finite(end)) for start, end in intervals)
    for start, end in normalized:
        if end < start or end > now + 60:
            raise ValueError('Invalid recording interval')
        if previous_end is not None:
            gap_start = max(previous_end, cutoff)
            if start - gap_start >= minimum_gap:
                gaps.append((gap_start, start))
        previous_end = max(previous_end if previous_end is not None else end, end)
    return gaps


def evaluate_camera(data: dict[str, Any], uptime: float,
                    warning: float, critical: float) -> tuple[int, str]:
    """Evaluate saved recording freshness and recent continuity, never FPS."""
    config = data['camera_config']
    if config is None:
        return 2, 'expected camera missing'
    if not config['enabled'] or not config['record_enabled']:
        return 2, 'expected camera or recording disabled'
    if uptime < 300:
        return 0, f'startup grace ({uptime:.0f}/300 seconds)'
    now = finite(data['now'])
    gaps = recording_gaps(data['recording_intervals'], now)
    hourly_gaps = recording_gaps(data['recording_intervals'], now, 3600)
    hourly_loss = sum(stop-start for start,stop in
                      recording_gaps(data['recording_intervals'], now, 3600, 5))
    budget_exceeded = len(hourly_gaps) >= 3 or hourly_loss >= 180
    missing = int(data['missing_recent_files'])
    if missing < 0:
        raise ValueError('Invalid missing file count')
    end = data['recording_end']
    age = None if end is None else max(0, now - finite(end))
    code = 0
    if age is None or not data['file_exists'] or missing or age > critical:
        code = 2
    elif age > warning or budget_exceeded:
        code = 1
    quality_code, quality_text, bad, sampled = evaluate_quality(data.get('quality', []), now)
    audio_code, audio_text, audio_bad, audio_sampled = (0, 'audio_not_required', 0, 0)
    timing_code, timing_text, timing_bad, timing_sampled = (0, 'av_timing_not_required', 0, 0)
    if data.get('audio_expected', False):
        audio_code, audio_text, audio_bad, audio_sampled = evaluate_quality(data.get('audio_quality', []), now)
        audio_text = audio_text.replace('quality_bad=', 'audio_bad=')
        timing_code, timing_text, timing_bad, timing_sampled = evaluate_quality(data.get('timing_quality', []), now)
        timing_text = timing_text.replace('quality_bad=', 'av_timing_bad=')
    # A definite recording failure outranks a diagnostic timeout (UNKNOWN).
    codes = (code, quality_code, audio_code, timing_code)
    known_code = max(value for value in codes if value != 3)
    code = known_code if known_code else 3 if 3 in codes else 0
    # One incident level avoids WARNING/CRITICAL oscillation emails for the
    # same camera fault. UNKNOWN stays distinct from proven recording loss.
    if code == 1:
        code = 2
    age_text = 'no saved file' if age is None or not data['file_exists'] else f'{age:.0f}s'
    perf_age = 'U' if age is None else f'{age:.1f}s'
    gap_text = 'none'
    if gaps:
        # Explicit UTC timestamps are independent of the host or email timezone.
        gap_text = ', '.join(
            f'{datetime.datetime.fromtimestamp(start, datetime.timezone.utc).isoformat(timespec="seconds")}'
            f'..{datetime.datetime.fromtimestamp(stop, datetime.timezone.utc).isoformat(timespec="seconds")}'
            f' ({stop - start:.0f}s)' for start, stop in gaps
        )
    return code, (f'recording_age={age_text}; recovered_gaps_15m={len(gaps)} [{gap_text}];'
                  f' significant_gaps_1h={len(hourly_gaps)}; loss_seconds_1h={hourly_loss:.0f};'
                  f' missing_recent_files={missing}; {quality_text}; {audio_text}; {timing_text}'
                  f' | recording_age={perf_age};{warning};{critical};0'
                  f' recovered_gaps_15m={len(gaps)};;;0'
                  f' significant_gaps_1h={len(hourly_gaps)};3;;0'
                  f' loss_seconds_1h={hourly_loss:.1f}s;180;;0'
                  f' missing_recent_files={missing};0;0;0'
                  f' quality_bad={bad};2;3;0;{sampled} quality_samples={sampled};;;0;3'
                  f' audio_bad={audio_bad};2;3;0;{audio_sampled} audio_samples={audio_sampled};;;0;3'
                  f' av_timing_bad={timing_bad};2;3;0;{timing_sampled}')


def evaluate_quality(samples: list[dict[str, Any]], now: float) -> tuple[int, str, int, int]:
    """Warn on 2/3 bad samples spanning >=45s; isolated failures stay informational."""
    usable = []
    for sample in samples:
        end = finite(sample['end'])
        status = sample['status']
        if status not in ('ok', 'bad', 'timeout', 'unavailable'):
            raise ValueError('Invalid quality status')
        if now - 120 <= end <= now + 5:
            usable.append((end, status))
    bad = sum(status == 'bad' for _, status in usable)
    span = max((end for end, _ in usable), default=0) - min((end for end, _ in usable), default=0)
    known = sum(status in ('ok', 'bad') for _, status in usable)
    code = 0
    if len(usable) >= 3 and span >= 45:
        code = 2 if bad >= 3 else 1 if bad >= 2 else 0
    if any(status in ('timeout', 'unavailable') for _, status in usable) and code == 0:
        code = 3
    return code, f'quality_bad={bad}/{known}; sampled={len(usable)}; span={span:.0f}s', bad, len(usable)


def evaluate_memory(data: dict[str, Any], warning: float,
                    critical: float) -> tuple[int, str]:
    """Retain tmpfs/shmem in working-set usage; expose cumulative event counters."""
    current, limit = int(data['current']), int(data['limit'])
    if current < 0 or limit <= 0:
        raise ValueError('Invalid memory limit or usage')
    working = max(0, current - int(data['stat']['inactive_file']))
    percent = 100 * working / limit
    code = 2 if percent >= critical else 1 if percent >= warning else 0
    events = data['events']
    return code, (f'working_set={working / 2**20:.0f}MiB/{limit / 2**20:.0f}MiB ({percent:.1f}%)'
                  f' | working_set_pct={percent:.2f}%;{warning};{critical};0;100'
                  f' memory_current={current}B;;;0;{limit} memory_working_set={working}B;;;0;{limit}'
                  f' memory_limit={limit}B;;;0 max_events={int(events["max"])}c'
                  f' oom_events={int(events["oom"])}c oom_kills={int(events["oom_kill"])}c')


def execute(command: list[str], deadline: float) -> str:
    """Bound combined Docker operations to twenty seconds; suppress raw stderr."""
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise subprocess.TimeoutExpired(command, 20)
    result = subprocess.run(command, capture_output=True, text=True,
                            timeout=remaining, check=True)
    return result.stdout


def main(argv: list[str] | None = None) -> int:
    """Return Nagios status without printing configuration or upstream secrets."""
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='mode', required=True)
    camera = commands.add_parser('camera')
    camera.add_argument('camera', choices=CAMERAS)
    camera.add_argument('--warning-age', type=float, default=120)
    camera.add_argument('--critical-age', type=float, default=300)
    memory = commands.add_parser('memory')
    memory.add_argument('--warning', type=float, default=85)
    memory.add_argument('--critical', type=float, default=95)
    args = parser.parse_args(argv)
    try:
        deadline = time.monotonic() + 20
        info = json.loads(execute(['/usr/bin/docker', 'inspect', '--format', '{{json .State}}', 'frigate'], deadline))
        if not info['Running']:
            print('FRIGATE CRITICAL: container not running')
            return 2
        started = datetime.datetime.fromisoformat(info['StartedAt'].replace('Z', '+00:00'))
        uptime = time.time() - started.timestamp()
        if args.mode == 'camera' and uptime < 300:
            print(f'FRIGATE {args.camera} OK: startup grace ({uptime:.0f}/300 seconds)')
            return 0
        name = getattr(args, 'camera', '')
        raw = execute(['/usr/bin/docker', 'exec', 'frigate', 'python3', '-c', DIAGNOSTIC, args.mode, name], deadline)
        data = json.loads(raw)
        if args.mode == 'camera':
            if not 0 <= args.warning_age < args.critical_age:
                raise ValueError('Invalid age thresholds')
            code, message = evaluate_camera(data, uptime, args.warning_age, args.critical_age)
        else:
            if not 0 <= args.warning < args.critical <= 100:
                raise ValueError('Invalid memory thresholds')
            code, message = evaluate_memory(data, args.warning, args.critical)
        print(f'FRIGATE {name or "memory"} {("OK", "WARNING", "CRITICAL", "UNKNOWN")[code]}: {message}')
        return code
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError, OverflowError) as error:
        print(f'FRIGATE UNKNOWN: diagnostic failed ({type(error).__name__}); check Docker permissions, API/schema and deadlines')
        return 3


if __name__ == '__main__':
    sys.exit(main())
