"""Read-only Frigate camera/recording and cgroup-memory Nagios checks."""
from __future__ import annotations

import argparse
import datetime
import json
import math
import subprocess
import sys
import time
from typing import Any

CAMERAS = ('Doorbell', 'Garage', 'Kitchen', 'Kids')
