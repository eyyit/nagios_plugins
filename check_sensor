#!/usr/bin/python3

import argparse
import json
import math
import subprocess
import sys


RETURN_VALUES = ('OK', 'WARNING', 'CRITICAL', 'UNKNOWN')


class PluginError(Exception):
  pass


class NagiosArgumentParser(argparse.ArgumentParser):

  def error(self, message):
    print(f'SENSOR UNKNOWN: {message}')
    raise SystemExit(3)


def one_line(value):
  return ' '.join(value.splitlines()).strip()


def get_status(value, warn, crit):
  if crit > warn:
    if value >= crit:
      return 2
    if value >= warn:
      return 1
  else:
    if value <= crit:
      return 2
    if value <= warn:
      return 1
  return 0


def get_sensor_data(sensor='', timeout=10):
  command = ['/usr/bin/sensors', '-f', '-j']
  if sensor:
    command.append(sensor)
  try:
    result = subprocess.run(
        command, capture_output=True, text=True, timeout=timeout, check=False)
  except subprocess.TimeoutExpired as error:
    raise PluginError(f'sensors timed out after {timeout} seconds') from error
  except OSError as error:
    raise PluginError(f'unable to run sensors: {error}') from error
  if result.returncode:
    detail = one_line(result.stderr) or f'exit status {result.returncode}'
    raise PluginError(f'sensors failed: {detail}')
  try:
    output = json.loads(result.stdout)
  except (json.JSONDecodeError, TypeError) as error:
    raise PluginError(f'invalid sensors JSON: {error}') from error
  if not isinstance(output, dict):
    raise PluginError('invalid sensors JSON: top-level value is not an object')
  return output


def find_metric(data, metric, sensor=''):
  if sensor:
    try:
      chips = {sensor: data[sensor]}
    except KeyError as error:
      raise PluginError(f'sensor not found: {sensor}') from error
  else:
    chips = data

  matches = []
  for chip, chip_data in chips.items():
    if not isinstance(chip_data, dict):
      continue
    for name, values in chip_data.items():
      if name.lower() == 'adapter' or metric.lower() not in name.lower():
        continue
      if not isinstance(values, dict):
        continue
      inputs = [(key, value) for key, value in values.items()
                if key.lower().endswith('_input')]
      for key, value in inputs:
        try:
          numeric_value = float(value)
        except (TypeError, ValueError) as error:
          raise PluginError(f'{chip} {name} has a non-numeric value') from error
        if not math.isfinite(numeric_value):
          raise PluginError(f'{chip} {name} has a non-finite value')
        matches.append((chip, name, key, numeric_value))

  if not matches:
    raise PluginError(f'metric not found: {metric}')
  if len(matches) > 1:
    raise PluginError(f'multiple metrics match {metric}; --sensor required')
  return matches[0]


def get_units(input_name):
  if 'fan' in input_name.lower():
    return 'RPM'
  if 'temp' in input_name.lower():
    return '°F'
  return ''


def main():
  parser = NagiosArgumentParser()
  parser.add_argument('--sensor', default='')
  parser.add_argument('--metric', required=True)
  parser.add_argument('--warn', type=float, required=True)
  parser.add_argument('--crit', type=float, required=True)
  parser.add_argument('--timeout', type=float, default=10)
  args = parser.parse_args()

  if not all(math.isfinite(value)
             for value in (args.warn, args.crit, args.timeout)):
    parser.error('Thresholds and timeout must be finite numbers.')
  if args.warn == args.crit:
    parser.error('--warn and --crit must not be equal.')
  if args.timeout <= 0:
    parser.error('--timeout must be greater than zero.')

  try:
    data = get_sensor_data(args.sensor, args.timeout)
    _, name, input_name, value = find_metric(data, args.metric, args.sensor)
  except PluginError as error:
    return 3, args.metric, str(error)
  units = get_units(input_name)
  message = f'{value:0.1f}' + (f' {units}' if units else '')
  return get_status(value, args.warn, args.crit), name, message


if __name__ == '__main__':
  status, metric, message = main()
  print(f'{metric.upper()} {RETURN_VALUES[status]}: {message}')
  sys.exit(status)
